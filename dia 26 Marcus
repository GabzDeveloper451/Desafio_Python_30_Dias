      "source": [
        "#Use uma função lambda com map ou filter para processar uma lista de números.\n",
        "\n",
        "#criando lista\n",
        "numeros = [10, 20, 30, 40, 50]\n",
        "\n",
        "#função lambda\n",
        "divididos = list(map(lambda x: x/10, numeros))\n",
        "\n",
        "\n",
        "\n",
        "print(f\"Números originais: {numeros}\")\n",
        "print(f\"Números divididos por 10: {divididos}\")"
